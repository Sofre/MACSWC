# MACSWC environment template
# Copy this file to .env and replace the placeholder values with your real keys.
# Never commit real secret values to Git.
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_key_here
BOARD_AGENT_API_KEY=your_board_agent_key_here
GROQ_API_KEY=your_groq_key_here
